# Postgres connection string. Against a managed host, ask for verify-full rather
# than require: the driver treats them the same today, but a coming major version
# will weaken require to libpq semantics, which skips certificate verification.
DATABASE_URL=postgresql://user:password@localhost:5432/cine_taste

# TMDB API read access token (v4 auth), from https://www.themoviedb.org/settings/api
TMDB_READ_TOKEN=
